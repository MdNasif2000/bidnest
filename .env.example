SECRET_KEY=secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email@gmail.com
EMAIL_HOST_PASSWORD=app-password

# Redis (Optional - only if using Celery or Channels)
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_PUBLIC_KEY=stripe-public-key
STRIPE_SECRET_KEY=stripe-secret-key
STRIPE_WEBHOOK_SECRET=webhook-secret

# DocuSign
DOCUSIGN_INTEGRATION_KEY=integration-key
DOCUSIGN_USER_ID=your-user-id
DOCUSIGN_ACCOUNT_ID=account-id
DOCUSIGN_PRIVATE_KEY_PATH=private-key

# Onfido (Document Verification)
ONFIDO_API_TOKEN=onfido-token

